{
  "name": "playwright-fail-on-console",
  "version": "1.0.1",
  "description": "Fail Playwright tests when console.error or console.warn fires — like jest-fail-on-console but for Playwright",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "playwright",
    "console",
    "error",
    "warn",
    "fail-on-console",
    "testing",
    "qa",
    "typescript",
    "e2e",
    "automation"
  ],
  "license": "MIT",
  "author": "Biswarak Raktim",
  "repository": {
    "type": "git",
    "url": "https://github.com/raktim1988/playwright-fail-on-console.git"
  },
  "homepage": "https://github.com/raktim1988/playwright-fail-on-console#readme",
  "bugs": {
    "url": "https://github.com/raktim1988/playwright-fail-on-console/issues"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
